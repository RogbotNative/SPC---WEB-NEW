# Everything here is OPTIONAL. The admin panel works with only a Vercel Blob store connected.
# For local development, copy to .env.local (never commit .env.local).

# Added automatically by Vercel when you connect a Blob store. Leave empty locally to save under .data/
BLOB_READ_WRITE_TOKEN=

# Optional: sign the session cookie with your own secret (32+ characters) instead of one derived from the Blob token.
SESSION_SECRET=

# Optional: sign-in details used only while none have been saved from the admin panel (Security → Sign-in details).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
