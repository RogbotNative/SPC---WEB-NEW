# Admin panel settings. In production, add these in Vercel → Project → Settings → Environment Variables.
# For local development, copy this file to .env.local (never commit .env.local).

# The name you sign in with
ADMIN_USERNAME=

# Recommended: run `npm run admin:hash-password` and paste the printed value here
ADMIN_PASSWORD_HASH=
# …or, simpler, the password itself (leave ADMIN_PASSWORD_HASH empty if you use this)
ADMIN_PASSWORD=

# 32+ random characters (the hash script prints one). Changing it signs everyone out.
SESSION_SECRET=

# Added automatically by Vercel when you connect a Blob store. Leave empty locally to save under .data/
BLOB_READ_WRITE_TOKEN=
